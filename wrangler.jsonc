{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "online-sync",
  "account_id": "b74fac168ae67c00ce65cced1528bf50",
  "workers_dev": true,
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-09",
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "online-sync",
      "database_id": "7845cdcd-7d1e-43e0-85da-88892820817b",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "SYNC_QUEUE", "queue": "online-sync-jobs" }],
    "consumers": [{ "queue": "online-sync-jobs", "max_batch_size": 10,
      "max_batch_timeout": 5, "max_retries": 5 }]
  },
  "triggers": { "crons": ["*/5 * * * *", "7 3 * * *"] },
  "vars": {
    "SHOPIFY_API_VERSION": "2026-07",
    "SHOPIFY_PARTNER_ORG_ID": "1882822",
    "SHOPIFY_APP_GID": "gid://shopify/App/433757585409",
    "SHOPIFY_APP_HANDLE": "onlinesync-3",
    "INVENTORY_WRITES_ENABLED": "true",
    "INVENTORY_WRITE_ALLOWED_SHOPS": "onlinesync-pilot-main.myshopify.com,onlinesync-pilot-second.myshopify.com"
  }
}
